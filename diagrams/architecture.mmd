%% PawPal+ — Applied AI System Architecture
%% Source of truth for assets/architecture.png. Preview/export: https://mermaid.live
%% Read the diagram as one loop: a request enters at the top, is grounded in
%% retrieved guidance, drafted by a model, checked by a validator, repaired if
%% it fails, and then held for human approval before it can touch the schedule.

flowchart TD

    subgraph IN["Interfaces"]
        UI["Streamlit UI<br/>app.py"]
        CLI["CLI demo<br/>demo_ai.py"]
        SETUP["Setup checker<br/>check_setup.py"]
    end

    REQ["Owner request<br/>natural language + pet context"]

    subgraph AGENT["Agent — pawpal_ai/agent.py"]
        RET["1. RETRIEVE<br/>query the knowledge base"]
        PLAN["2. PLAN<br/>prompt the model for JSON"]
        VAL["3. VALIDATE<br/>schema, pets, times, conflicts, citations"]
        REPAIR["4. REPAIR<br/>feed the errors back to the model"]
        CONF["5. SCORE CONFIDENCE<br/>discount for repairs and missing grounding"]
    end

    subgraph KB["Retrieval — pawpal_ai/retriever.py"]
        DOCS[("knowledge_base/<br/>5 documents, 31 passages")]
        INDEX["TF-IDF index<br/>stemming + domain gate"]
    end

    subgraph MODEL["Providers — pawpal_ai/providers.py"]
        GEM["GeminiProvider<br/>REST, retries, typed errors"]
        STUB["StubProvider<br/>deterministic offline fallback"]
    end

    GATE{"HUMAN APPROVAL<br/>owner reviews plan,<br/>sources and trace"}

    subgraph LOGIC["Logic layer — pawpal_system.py (unchanged)"]
        SCHED["Scheduler<br/>sort, filter, detect_conflicts"]
        MODEL_O["Owner → Pet → Task"]
    end

    subgraph VERIFY["Verification"]
        TESTS["pytest<br/>61 tests, fakes for failure paths"]
        EVAL["evaluate.py<br/>25 cases → evaluation/results.md"]
        TRACE[("logs/traces.jsonl<br/>auditable run history")]
    end

    UI --> REQ
    CLI --> REQ
    REQ --> RET

    DOCS --> INDEX
    INDEX -->|top-k passages + citations| RET
    INDEX -.->|no passage clears the gate| REFUSE["Refuse to answer<br/>rather than improvise"]

    RET -->|grounded context| PLAN
    PLAN --> GEM
    GEM -->|"API error, timeout, 429"| STUB
    GEM -->|JSON| VAL
    STUB -->|JSON| VAL

    VAL -->|invalid| REPAIR
    REPAIR -->|corrected prompt, bounded retries| PLAN
    VAL -->|valid| CONF
    CONF --> GATE

    SCHED -->|existing times| VAL

    GATE -->|approved| MODEL_O
    GATE -->|discarded| REQ
    MODEL_O --> SCHED
    SCHED --> UI

    SETUP -.->|verifies before use| MODEL
    SETUP -.-> KB
    AGENT -.->|every step recorded| TRACE
    TESTS -.->|assert guardrails| VAL
    EVAL -.->|measure retrieval + planning| AGENT

    classDef iface fill:#e3f2fd,stroke:#1565c0,color:#0d223a
    classDef agent fill:#f3e5f5,stroke:#6a1b9a,color:#2a0d33
    classDef kb fill:#e0f7fa,stroke:#00838f,color:#04262b
    classDef model fill:#fff3e0,stroke:#ef6c00,color:#3a1d02
    classDef logic fill:#e8f5e9,stroke:#2e7d32,color:#0f2a14
    classDef verify fill:#fbe9e7,stroke:#c62828,color:#3a0f0d
    classDef human fill:#fffde7,stroke:#f9a825,color:#3a2c05,stroke-width:3px

    class UI,CLI,SETUP,REQ iface
    class RET,PLAN,VAL,REPAIR,CONF,REFUSE agent
    class DOCS,INDEX kb
    class GEM,STUB model
    class SCHED,MODEL_O logic
    class TESTS,EVAL,TRACE verify
    class GATE human
