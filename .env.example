# Copy this file to .env and fill in your key:  cp .env.example .env
# .env is gitignored, so your key never reaches GitHub.

# Free API key from https://aistudio.google.com  (no credit card required).
GEMINI_API_KEY=

# --- Optional overrides (sensible defaults are built in) --------------------

# "gemini" calls the real API. "stub" forces the offline deterministic
# provider — this is what the test suite and eval harness use.
PAWPAL_PROVIDER=gemini

# Model ID. Run `python check_setup.py` to list the models your key supports.
PAWPAL_MODEL=gemini-2.0-flash

# Low temperature: we want structured schedule data, not creative prose.
PAWPAL_TEMPERATURE=0.2
PAWPAL_MAX_TOKENS=2048
PAWPAL_TIMEOUT=30
PAWPAL_MAX_RETRIES=2

# Retrieval: how many knowledge-base chunks to ground each plan in.
PAWPAL_TOP_K=3

# How many times the agent may repair invalid model output before falling back.
PAWPAL_MAX_REPAIRS=2
